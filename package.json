{
  "name": "physical-model-charts",
  "version": "1.0.0",
  "description": "ISA-88 Physical Model diagrams — a shared core rendered into Obsidian, VS Code, and Fumadocs targets.",
  "private": true,
  "license": "MIT",
  "author": "ACRO",
  "workspaces": [
    "pm-source/core",
    "pm-source/obsidian",
    "pm-source/vscode",
    "pm-source/fumadocs"
  ],
  "scripts": {
    "build": "tsc -noEmit && tsc -p pm-source/fumadocs/tsconfig.json && node build.mjs",
    "build:obsidian": "tsc -noEmit && node build.mjs obsidian",
    "build:vscode": "tsc -noEmit && node build.mjs vscode",
    "build:fumadocs": "tsc -p pm-source/fumadocs/tsconfig.json && node build.mjs fumadocs",
    "pack:fumadocs": "npm run build:fumadocs && npm pack ./output/fumadocs --pack-destination ./output",
    "icon": "node pm-source/vscode/scripts/make-icon.mjs",
    "preview": "node scripts/make-preview.mjs",
    "dev": "node build.mjs obsidian --watch",
    "dev:vscode": "node build.mjs vscode --watch",
    "test": "node pm-source/core/esbuild.tests.mjs && node --test \"pm-source/core/tests-dist/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write \"pm-source/**/*.ts\"",
    "format:check": "prettier --check \"pm-source/**/*.ts\""
  },
  "keywords": [
    "obsidian",
    "vscode",
    "fumadocs",
    "isa-88",
    "physical-model",
    "equipment-hierarchy",
    "diagram"
  ],
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "eslint": "^9.39.5",
    "obsidian": "^1.4.11",
    "prettier": "^3.9.6",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.69.0"
  }
}
