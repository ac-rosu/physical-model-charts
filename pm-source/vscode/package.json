{
  "name": "physical-model-charts",
  "displayName": "Physical Model Charts (ISA-88)",
  "description": "Render ISA-88 physical models (enterprise to control module) from `physical` code blocks in the Markdown preview.",
  "version": "1.2.0",
  "publisher": "acro",
  "license": "MIT",
  "author": "ACRO",
  "repository": {
    "type": "git",
    "url": "https://github.com/ac-rosu/physical-model-charts"
  },
  "bugs": {
    "url": "https://github.com/ac-rosu/physical-model-charts/issues"
  },
  "homepage": "https://github.com/ac-rosu/physical-model-charts#readme",
  "icon": "media/icon.png",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#0f766e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "isa-88",
    "physical model",
    "equipment hierarchy",
    "markdown",
    "diagram"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/pm-preview.css"
    ],
    "markdown.previewScripts": [
      "./media/pm-preview.js"
    ]
  },
  "devDependencies": {
    "@pm/core": "*"
  }
}
