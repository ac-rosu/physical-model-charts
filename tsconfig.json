{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "paths": {
      "@pm/core": ["./pm-source/core/src/index.ts"]
    },
    "allowJs": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strict": true,
    "lib": ["DOM", "ES2018", "ES2020"],
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["pm-source/*/src/**/*.ts"],
  "exclude": ["pm-source/fumadocs/**"]
}
